@model LibraryTracker.Models.Book
@{
    ViewData["Title"] = "Edit Book";
}

<div class="card" style="max-width: 500px;">
    <h1>Edit Book</h1>

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" required />
        </div>
        <div class="form-group">
            <label asp-for="Author"></label>
            <input asp-for="Author" required />
        </div>
        <div class="form-group">
            <label asp-for="ISBN"></label>
            <input asp-for="ISBN" />
        </div>
        <button type="submit" class="btn">Update</button>
        <a asp-action="Index" class="btn" style="background:#95a5a6;">Cancel</a>
    </form>
</div>
